# Root environment used by docker compose.
# Copy to `.env` and replace placeholder secrets before starting.

# Required — use a long random value (32+ characters). Do not reuse this placeholder
# when running with NODE_ENV=production outside local Compose testing.
JWT_SECRET=change_me_to_a_long_random_secret

# Optional
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:8080
# Comma-separated extra origins (Vite local + Docker UI).
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Local Compose defaults ALLOW_PUBLIC_REGISTER to true so you can create the first user.
# Set to false for locked-down deployments.
ALLOW_PUBLIC_REGISTER=true

# Alert-check scheduler: applied to the Notification Service (the only scheduler).
# EXPIRATION_WARNING_DAYS also sets the Inventory and Reporting "expiring soon" window.
EXPIRATION_WARNING_DAYS=30
STOCK_CHECK_INTERVAL_MS=3600000
STOCK_CHECK_ENABLED=true

# Optional shared secret for service-to-service /internal/* calls
# (Notification/Sales/Purchase → Inventory Service, header x-internal-token).
# Empty = network isolation only.
INTERNAL_API_TOKEN=

# Public API is the Gateway on host :5000 (the only public backend entry point).
#   /api/auth/*, /api/audit-logs → Auth Service (debug: 127.0.0.1:5002)
#   /api/medicines/*, /api/categories/* → Medicine Service (debug: 127.0.0.1:5003)
#   /api/batches/*, /api/stock/*, /api/alerts/* (except /api/alerts/check)
#       → Inventory Service (debug: 127.0.0.1:5004)
#   /api/notifications/*, /api/alerts/check → Notification Service (debug: 127.0.0.1:5005)
#   /api/sales/* → Sales Service (debug: 127.0.0.1:5006)
#   /api/purchases/*, /api/suppliers/* → Purchase Service (debug: 127.0.0.1:5007)
#   /api/dashboard/*, /api/reports/* → Reporting Service, read-only (debug: 127.0.0.1:5008)
#   /api/health → answered by the Gateway; any other /api/* → 404
#   /internal/* is never exposed by the Gateway.
# NEVER run: docker compose down -v
