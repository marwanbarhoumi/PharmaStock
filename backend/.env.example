PORT=5000
# Requires a local MongoDB instance listening on port 27017.
# Database name: pharmastock
# If "localhost" resolves to IPv6 (::1) and connection fails while MongoDB is running,
# try: mongodb://127.0.0.1:27017/pharmastock
MONGODB_URI=mongodb://localhost:27017/pharmastock

# JWT authentication (Phase 4)
# Use a long, random secret in real environments. Never commit real secrets.
JWT_SECRET=change_me_to_a_long_random_secret

CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Phase 6 — Smart Management
# Days before batch expiration that trigger EXPIRATION_WARNING notifications
EXPIRATION_WARNING_DAYS=30
# Automatic stock-check interval in milliseconds (minimum 60000)
STOCK_CHECK_INTERVAL_MS=3600000
# Set to false to disable the background stock-check scheduler
STOCK_CHECK_ENABLED=true
