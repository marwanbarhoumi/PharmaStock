# Local development: Vite talks to the API Gateway on the host (Compose).
# The Gateway routes /api/* to the services. Paths stay /api/...
# Docker production builds override this with `/api` (Nginx → Gateway).
# Vercel: set VITE_API_URL=https://<gateway>.onrender.com/api in the project settings (read at build time).
VITE_API_URL=http://localhost:5000/api
