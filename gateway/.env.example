# API Gateway: single public backend entry point.
# Routes /api/* to the services. No business logic, no database access.
# Unrouted /api/* paths return 404; /api/health is answered by the Gateway.

PORT=5000
# Auth Service (users / JWT / audit-logs)
AUTH_URL=http://127.0.0.1:5002
# Medicine Service (medicines / categories / barcode)
MEDICINE_URL=http://127.0.0.1:5003
# Inventory Service (batches / stock / movements / FEFO / alert reads)
INVENTORY_URL=http://127.0.0.1:5004
# Notification Service (notifications / alert check)
NOTIFICATION_URL=http://127.0.0.1:5005
# Sales Service (sales, sale items, cancellation)
SALES_URL=http://127.0.0.1:5006
# Purchase Service (purchases, purchase items, suppliers)
PURCHASE_URL=http://127.0.0.1:5007
# Reporting Service (dashboard, reports, CSV exports; read-only)
REPORTING_URL=http://127.0.0.1:5008
NODE_ENV=development

# Browser origins (CORS is handled by each service; kept for reference)
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
