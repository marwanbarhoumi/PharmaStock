PORT=5004
# Same database as every other service. Do not point at a different DB name.
MONGODB_URI=mongodb://127.0.0.1:27017/pharmastock
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
EXPIRATION_WARNING_DAYS=30
# Authenticate via Auth Service introspection (set in Docker)
AUTH_SERVICE_URL=http://127.0.0.1:5002
# Optional: validate medicines on batch writes via Medicine Service internal catalog
MEDICINE_SERVICE_URL=http://127.0.0.1:5003
# Optional: shared secret required on /internal/inventory/* (header x-internal-token)
# INTERNAL_API_TOKEN=
NODE_ENV=development
