PORT=5005
# Same database as every other service. Do not point at a different DB name.
MONGODB_URI=mongodb://127.0.0.1:27017/pharmastock
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Authenticate via Auth Service introspection (required in production)
AUTH_SERVICE_URL=http://127.0.0.1:5002
# Inventory Service: alert data + medicine/batch display fields (internal endpoints)
INVENTORY_SERVICE_URL=http://127.0.0.1:5004
# Optional shared secret sent as x-internal-token (must match Inventory Service)
# INTERNAL_API_TOKEN=
# Alert-check scheduler (this service is the ONLY scheduler once extracted)
EXPIRATION_WARNING_DAYS=30
STOCK_CHECK_INTERVAL_MS=3600000
STOCK_CHECK_ENABLED=true
NODE_ENV=development
