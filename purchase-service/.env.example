PORT=5007
# Same database as every other service. Do not point at a different DB name.
MONGODB_URI=mongodb://127.0.0.1:27017/pharmastock
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Authenticate via Auth Service introspection (required in production)
AUTH_SERVICE_URL=http://127.0.0.1:5002
# Medicine Service: medicine validation + display fields (internal catalog endpoints)
MEDICINE_SERVICE_URL=http://127.0.0.1:5003
# Inventory Service: purchase batches, PURCHASE movements, batch display fields (internal endpoints)
INVENTORY_SERVICE_URL=http://127.0.0.1:5004
# Timeout per internal call. A timed-out Inventory write is never retried (logged for reconciliation).
SERVICE_TIMEOUT_MS=10000
# Optional shared secret sent as x-internal-token (must match Inventory Service)
# INTERNAL_API_TOKEN=
NODE_ENV=development
